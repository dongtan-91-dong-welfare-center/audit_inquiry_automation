# --- 환경 설정 ---
ENV=development
LOG_LEVEL=INFO

# --- 경로 설정 ---
DATA_PATH=./data
STORAGE_PATH_UPLOAD=./data/uploads

# --- OCR 설정 ---
OCR_ENGINE=paddleocr
OCR_LANGUAGE=eng+kor
OCR_CONFIDENCE_THRESHOLD=80

# --- 처리 옵션 ---
ASYNC_TASK_CONCURRENCY=2
MAX_UPLOAD_FILE_SIZE_MB=100
AUDIT_DATA_RETENTION_DAYS=30
EXPORT_FORMAT=xlsx